generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  password  String
  name      String?
  role      Role     @default(CUSTOMER)
  vehicleNo String?  // For drivers/customers
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  repairJobs  RepairJob[] @relation("MechanicJobs")
  warranties  Warranty[]
}

enum Category {
  MOTORS
  CONTROLLERS
  BATTERIES
  CHARGERS
  WIRING
  BODY_PARTS
  ACCESSORIES
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model Part {
  id             String      @id @default(uuid())
  name           String
  brand          String?
  partCode       String      @unique
  category       Category
  retailPrice    Float
  wholesalePrice Float
  stockStatus    StockStatus @default(IN_STOCK)
  imageUrl       String?     // Cloudinary URL
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  warranties     Warranty[]
  repairJobs     RepairJob[]
}

enum JobStatus {
  PENDING
  IN_REPAIR
  COMPLETED
}

model RepairJob {
  id          String    @id @default(uuid())
  token       String    @unique // e.g., RJ-1001
  status      JobStatus @default(PENDING)
  
  mechanicId  String?
  mechanic    User?     @relation("MechanicJobs", fields: [mechanicId], references: [id])
  
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Warranty {
  id           String   @id @default(uuid())
  serialNumber String   @unique
  purchaseDate DateTime @default(now())
  durationDays Int      // e.g., 365 for 1 year
  
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  partId       String
  part         Part     @relation(fields: [partId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
